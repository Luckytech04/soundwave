# Soundwave Music Player — Environment Variables Example
# Duplicate this file to .env or .env.local to customize your instance

# Jamendo API Client ID (Free public developer credentials)
# Obtain your free client ID at: https://developer.jamendo.com/v3.0
VITE_JAMENDO_CLIENT_ID=56d30c95

# Audius Host Discovery Provider (Optional custom node)
# Default: https://discoveryprovider.audius.co
VITE_AUDIUS_HOST=https://discoveryprovider.audius.co

# Audius App Name Identifier
VITE_AUDIUS_APP_NAME=SOUNDWAVE_PLAYER

# Optional Supabase Backend Sync Configuration (Optional for multi-device sync)
# If left empty, Soundwave operates 100% offline-first using client-side IndexedDB & localStorage
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
